# Copia a .env y rellena. NUNCA commitear .env (Principio VI de la constitución).

# --- Base de datos ---------------------------------------------------------
# Local con Docker: postgresql+asyncpg://leagueflow@localhost:5432/leagueflow
# Railway inyecta DATABASE_URL automáticamente (esquema postgresql://; la app
# lo normaliza a postgresql+asyncpg:// al arrancar).
DATABASE_URL=

# --- Seguridad -------------------------------------------------------------
# Orígenes permitidos por CORS, separados por coma. NUNCA "*" (constitución).
# Desarrollo: http://localhost:5173   Producción: https://<tu-app>.vercel.app
ALLOWED_ORIGINS=

# Cookies Secure/SameSite=None exigen HTTPS. En local (http) se desactiva
# poniendo false; en producción SIEMPRE true.
COOKIE_SECURE=

# --- Organizador semilla (research.md §10) ---------------------------------
# El script backend/scripts/seed_admin.py falla si estas dos faltan: no existe
# credencial por defecto, a propósito.
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
